op/x_864,y_0,w_3456,h_3456/fill/w_163,h_163,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Ozkan%20Guner.jpg 1x, https://static.wixstatic.com/media/nsplsh_9f8cbf3fa3134d6fb76ef8de6108294d~mv2.jpg/v1/crop/x_864,y_0,w_3456,h_3456/fill/w_326,h_326,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Ozkan%20Guner.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":163,"height":163,"objectFit":"cover"}}},"containerWidth":163,"containerHeight":163,"isInFirstFold":true,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-m7cerijk4","mainPageId":"a4aio","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-m7cerijl1":{"html":"<h3 class=\"font_5 wixui-rich-text__text\" style=\"font-size:20px; text-align:center;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Root Canal Treatments</span></h3>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m7cerijm":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em; text-align:justify;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Root canal treatments have a bad reputation in Ireland for being painful treatments and easily failing. These statements couldn&#39;t be further from the truth. </span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em; text-align:justify;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">The goal of a root canal is to save a tooth that is badly decayed or infected. By gently removing the infection and restoring the tooth from the inside, this treatment relieves pain and helps keep your natural smile and health. When well done and cared this treatment could be done with minimal to no pain and be able to save a tooth for a few years.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m7cerijm5":{"hasAnimation":false,"crop":{"x":170,"y":0,"width":1871,"height":1871,"svgId":"cf545b123b6e4523b228d62bfa0dea9b.svg"},"alt":"person holding pink electric toothbrush_","width":2211,"height":1871,"uri":"db9b9a_75995c2a00f84797a0c7ad8db7b9b44e~mv2.jpg","name":"person holding pink electric toothbrush_","containerId":"comp-m7cerijm5","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/db9b9a_75995c2a00f84797a0c7ad8db7b9b44e~mv2.jpg/v1/crop/x_170,y_0,w_1871,h_1871/fill/w_163,h_163,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/person%20holding%20pink%20electric%20toothbrush_.jpg","srcset":"https://static.wixstatic.com/media/db9b9a_75995c2a00f84797a0c7ad8db7b9b44e~mv2.jpg/v1/crop/x_170,y_0,w_1871,h_1871/fill/w_163,h_163,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/person%20holding%20pink%20electric%20toothbrush_.jpg 1x, https://static.wixstatic.com/media/db9b9a_75995c2a00f84797a0c7ad8db7b9b44e~mv2.jpg/v1/crop/x_170,y_0,w_1871,h_1871/fill/w_326,h_326,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/person%20holding%20pink%20electric%20toothbrush_.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":163,"height":163,"objectFit":"cover"}}},"containerWidth":163,"containerHeight":163,"isInFirstFold":true,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-m7cerijm5","mainPageId":"a4aio","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-m7cerijn1":{"html":"<h3 class=\"font_5 wixui-rich-text__text\" style=\"font-size:20px; text-align:center;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Hygiene</span></h3>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m7cerijo":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em; text-align:justify;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Regular visits to the dental hygienist keep your teeth and gums healthy. Professional cleanings remove buildup that brushing alone can&rsquo;t, helping prevent problems and keeping your smile fresh and bright.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m7cerijo5":{"hasAnimation":false,"crop":{"x":0,"y":0,"width":2340,"height":2340,"svgId":"cf545b123b6e4523b228d62bfa0dea9b.svg"},"alt":"Image by Katarzyna Zygnerska","width":2340,"height":2340,"uri":"nsplsh_c59820879a0b4d8bb32a1fac70ad3c26~mv2.jpg","name":"Image by Katarzyna Zygnerska","containerId":"comp-m7cerijo5","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/nsplsh_c59820879a0b4d8bb32a1fac70ad3c26~mv2.jpg/v1/fill/w_163,h_163,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Katarzyna%20Zygnerska.jpg","srcset":"https://static.wixstatic.com/media/nsplsh_c59820879a0b4d8bb32a1fac70ad3c26~mv2.jpg/v1/fill/w_163,h_163,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Katarzyna%20Zygnerska.jpg 1x, https://static.wixstatic.com/media/nsplsh_c59820879a0b4d8bb32a1fac70ad3c26~mv2.jpg/v1/fill/w_326,h_326,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Katarzyna%20Zygnerska.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":163,"height":163,"objectFit":"cover"}}},"containerWidth":163,"containerHeight":163,"isInFirstFold":true,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-m7cerijo5","mainPageId":"a4aio","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-m7cerijq":{"html":"<h3 class=\"font_5 wixui-rich-text__text\" style=\"font-size:20px; text-align:center;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Invisalign</span></h3>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m7cerijr":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px; line-height:1.8em; text-align:justify;\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Invisalign straightens teeth comfortably and discreetly using clear aligners. It&rsquo;s a modern alternative to braces that fits easily into your lifestyle, helping you achieve a confident smile without metal wires or brackets.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mf2k60qv":{"html":"<h3 class=\"font_5 wixui-rich-text__text\" style=\"font-size:20px; text-align:center;\"><span style=\"font-size:20px;\" class=\"wixui-rich-text__text\">Dental Implants</span></h3>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mf2k4zx6":{"hasAnimation":false,"crop":{"x":0,"y":0,"width":6000,"height":6000,"svgId":"cf545b123b6e4523b228d62bfa0dea9b.svg"},"alt":"Image by Andreea Rus","width":6000,"height":6000,"uri":"nsplsh_8b98f036db694d23a17d1ebd772be567~mv2.jpg","name":"Image by Andreea Rus","containerId":"comp-mf2k4zx6","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fa