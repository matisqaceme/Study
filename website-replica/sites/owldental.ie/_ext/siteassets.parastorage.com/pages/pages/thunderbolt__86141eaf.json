trengthen damaged teeth while enhancing their look. Veneers are thin, custom shells that cover the front of teeth to fix stains, gaps, or misalignment. Both options deliver a natural, confident smile.</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m7ceq0om5":{"hasAnimation":false,"crop":{"x":771,"y":0,"width":3083,"height":3083,"svgId":"cf545b123b6e4523b228d62bfa0dea9b.svg"},"alt":"Image by Jonathan Borba","width":4624,"height":3083,"uri":"nsplsh_4b8d9feb98f74279aa8254bc0bfd9fa5~mv2.jpg","name":"Image by Jonathan Borba","containerId":"comp-m7ceq0om5","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/nsplsh_4b8d9feb98f74279aa8254bc0bfd9fa5~mv2.jpg/v1/crop/x_771,y_0,w_3083,h_3083/fill/w_163,h_163,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Jonathan%20Borba.jpg","srcset":"https://static.wixstatic.com/media/nsplsh_4b8d9feb98f74279aa8254bc0bfd9fa5~mv2.jpg/v1/crop/x_771,y_0,w_3083,h_3083/fill/w_163,h_163,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Jonathan%20Borba.jpg 1x, https://static.wixstatic.com/media/nsplsh_4b8d9feb98f74279aa8254bc0bfd9fa5~mv2.jpg/v1/crop/x_771,y_0,w_3083,h_3083/fill/w_326,h_326,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Jonathan%20Borba.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":163,"height":163,"objectFit":"cover"}}},"containerWidth":163,"containerHeight":163,"isInFirstFold":true,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"en","compId":"comp-m7ceq0om5","mainPageId":"a4aio","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Expand image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-m7ceq0