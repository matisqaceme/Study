nagingAppDefId":""},"domSelectors":{"allComponentIds":["rhiua","pageBackground_rhiua","Containerrhiua","comp-mf2ha1tl","comp-mf2ha1u9","comp-mf2ha1uc","comp-mf2ha1ud2","comp-mf2hjy6a","comp-mf2ha1ue2","comp-mf2ha1us1","comp-mf2ha1uu"]},"components":{"componentsUnderFoldMap":{"comp-mf2ha1ud2":{"componentType":"wysiwyg.viewer.components.ClassicSection","compId":"comp-mf2ha1ud2"},"comp-mf2hjy6a":{"componentType":"wysiwyg.viewer.components.WRichText","compId":"comp-mf2hjy6a"},"comp-mf2ha1ue2":{"componentType":"wysiwyg.viewer.components.WPhoto","compId":"comp-mf2ha1ue2"},"comp-mf2ha1us1":{"componentType":"wysiwyg.viewer.components.WPhoto","compId":"comp-mf2ha1us1"},"comp-mf2ha1uu":{"componentType":"wysiwyg.viewer.components.WPhoto","compId":"comp-mf2ha1uu"}}},"__componentsConfig__":{},"render":{"compProps":{"rhiua":{"className":"theme-vars"},"pageBackground_rhiua":{"fillLayers":{"containerId":"pageBackground_rhiua","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"isMediaPositionOverride":false,"mediaHeightOverrideType":""},"Containerrhiua":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}},"comp-mf2ha1tl":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-mf2ha1tl","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-mf2ha1u9":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:32px; line-height:normal; text-align:center;\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span style=\"font-size:32px;\" class=\"wixui-rich-text__text\">Owl Dental Implants</span></span></h1>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mf2ha1uc":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:16px;\"><span style=\"font-size:19px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">&quot;<span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Best Treatment if you lose a tooth</span>&quot;</span></span>, <span style=\"font-size:14px;\" class=\"wixui-rich-text__text\">Dr. Andre Lemos</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:16px;\"><span class=\"wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">At our dental practice, we focus on preserving the natural lifespan of your teeth through a variety of treatments aimed at controlling decay and gum disease. However, there are times when a tooth cannot be saved. In these cases, several replacement options are available. When recommended, a <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Dental implant,&nbsp;</span>when expertly placed and properly cared for, offers the <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">most durable and long-lasting solution, <span style=\"font-weight:normal;\" class=\"wixui-rich-text__text\">without question.</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span class=\"wixui-rich-text__text\">​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\">Our <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Goal</span> is to offer our patients the possibility of having this treatment in our practice, easily accessible with the best Materials and with the best aftercare and service possible.&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">​</span>​</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span class=\"wixui-rich-text__text\">For all these reasons, we are investing heavily in <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Straumann</span> Implants that are world-renowned for being top-class in their durability, advanced material, and High success rates. &nbsp;</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mf2ha1ud2":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-mf2ha1ud2","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Play","pauseLabel":"Pause"}},"comp-mf2hjy6a":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:22px;\"><span style=\"font-size:22px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Straumann Implants</span> &ndash; The World&rsquo;s Leading Choice<br class=\"wixui-rich-text__text\">\nWe use Straumann implants, trusted globally for their precision, durability, and natural-looking results, helping you achieve a healthy, confident smile that lasts.</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mf2ha1ue2":{"hasAnimation":false,"alt":"Image by Jonathan Borba","width":5472,"height":3648,"uri":"nsplsh_d2a26af95a914551b3cdcd31d3ebe37b~mv2.jpg","name":"Image by Jonathan Borba","containerId":"comp-mf2ha1ue2","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/nsplsh_d2a26af95a914551b3cdcd31d3ebe37b~mv2.jpg/v1/fill/w_280,h_150,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/Image%20by%20Jonathan%20Borba.jpg