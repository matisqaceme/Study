{
  "name": "website-replica",
  "private": true,
  "type": "module",
  "description": "Rendered static mirror of a website (crawl, rewrite, verify, serve).",
  "scripts": {
    "crawl": "node crawl.mjs https://www.owldental.ie/ site --wait=2000 --links=dir",
    "verify": "node verify.mjs site",
    "serve": "node serve.mjs site 8080",
    "test": "bash test/run.sh"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
